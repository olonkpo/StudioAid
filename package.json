{
  "name": "studioaid",
  "productName": "StudioAid",
  "version": "0.1.0",
  "description": "Floating bubble project tracker for photographers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.studioaid.app",
    "productName": "StudioAid",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**"
    ],
    "icon": "assets/icon.png",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}